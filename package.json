{
  "name": "open-agents-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "generate": "bun --filter '*' generate",
    "typecheck": "bun --filter '*' typecheck",
    "biome": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "orval": "8.19.0",
    "typescript": "7.0.1-rc"
  }
}
