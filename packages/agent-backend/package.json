{
  "name": "@open-agents-platform/agent-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma db push --skip-generate && vite dev",
    "build": "prisma generate && vite build",
    "start": "prisma db push --skip-generate && node dist/server.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "generate": "orval",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@flue/runtime": "2.0.1",
    "@hono/zod-validator": "0.8.0",
    "@prisma/client": "6.19.3",
    "hono": "4.12.27",
    "valibot": "1.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@flue/vite": "2.0.1",
    "@types/bun": "1.3.14",
    "prisma": "6.19.3",
    "vite": "8.1.0"
  }
}
