# ============================================================
# open-agents-platform — environment variables
#
# The dev stack reads exactly ONE env file:
#
#     packages/agent-backend/.env
#
# Bun loads .env from each process's own cwd, and `bun --filter '*' dev`
# does NOT pass a repo-root .env down to the packages — a .env placed
# beside this file is read by nothing. Copy this template there:
#
#     cp .env.example packages/agent-backend/.env
#
# The agent-frontend runs entirely on the defaults compiled into its own
# config module (app/config.ts). Give it its own .env only to override a
# VITE_* default listed at the bottom of this file.
#
# These are server-side values. Never expose them in a frontend bundle or
# any browser-reachable response.
# ============================================================

# --- Required ------------------------------------------------

# Model the agents run on, as `provider/model-id`.
# Unset defaults to anthropic/claude-sonnet-4-6.
AGENT_MODEL=anthropic/claude-sonnet-4-6

# Key for the provider named in AGENT_MODEL. flue resolves it from the
# provider id: `anthropic` reads ANTHROPIC_API_KEY, `google` reads
# GEMINI_API_KEY. Set the one your model needs.
# NOTE: GOOGLE_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY are NOT read.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Recommended outside local dev ---------------------------

# HMAC key signing the Bearer tokens issued by POST /session. Unset falls
# back to a fixed, publicly-known dev default — override it anywhere shared.
# APP_SESSION_SECRET=

# --- Optional overrides --------------------------------------
# Defaults below are the values compiled into the code and are correct for
# local dev. Uncomment one only to change it, in the .env of the package
# it belongs to.
#
# packages/agent-backend — src/config.ts
#   MCP_SERVER_URL=http://localhost:41005/mcp   # must include the /mcp path
#   MCP_SERVER_TOKEN=                           # only if the MCP server requires auth
#   FRONTEND_ORIGIN=http://localhost:41173      # CORS allow-list
#   APP_SESSION_TTL_SECONDS=43200
#   AGENT_MODEL_CHOICES=<AGENT_MODEL>           # models a custom agent may select
#   CACHE_TTL_MS=1800000                        # dataKey cache sliding TTL
#   CACHE_MAX_ENTRIES=1000
#   INTERNAL_API_SECRET=dev-internal-secret-change-me  # guards /channels/crm/*
#
# packages/agent-frontend — app/config.ts (VITE_*, reaches the browser)
#   VITE_BACKEND_URL=http://localhost:41080
